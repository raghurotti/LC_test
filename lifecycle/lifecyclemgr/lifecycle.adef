//--------------------------------------------------------- 
// LIFECYCLE MANAGER 
//---------------------------------------------------------

sandboxed: false
start: auto

components:
{
	lcComponent
}

processes:
{
    run:
    {
      lifecycle = ( lifecycle )
    }
    envVars:
    {
        LE_LOG_LEVEL = DEBUG
    }
}

extern:
{
    provides:
    {
        lifecycle = $LEGATO_MM_API/lifecycle.api
    }
    requires:
    {
         le_appCtrl = le_appCtrl.api
    }
}

bindings:
{
	*.le_appCtrl -> le_appCtrl.le_appCtrl
}

capabilities:
{ 
    CAP_DAC_OVERRIDE
    CAP_SYS_NICE
    CAP_SYS_TIME
    CAP_MAC_OVERRIDE
    CAP_WAKE_ALARM
    CAP_BLOCK_SUSPEND
    CAP_NET_ADMIN
    CAP_NET_RAW
}
